#!/bin/bash
# Installs the locally built RPM in dom0. There's a single universal noarch
# package (built by `just rpm` / `nix build .#rpm`), so just find it and install it.
set -euo pipefail


pkg="$(find rpm-build/RPMS/noarch -type f -iname '*.noarch.rpm' | sort -V | tail -n1)"
if [[ -z $pkg ]]; then
    echo "ERROR: No RPM found. Run 'just rpm' in the AppVM, then try again." >&2
    exit 1
fi

echo "Installing ${pkg}..."
# Disable "qubes-dom0-cached" repo to avoid problems with local rpm installation.
# sudo dnf --disablerepo=qubes-dom0-cached install -y "$pkg"
sudo dnf install -y "$pkg"
