#!/bin/bash
# Runs reprotest against the dom0 RPM build.
#
# reprotest is a host-level harness: it introspects the system and rebuilds with
# the native Fedora rpm toolchain. Inside the Nix dev shell the Nix `rpm` shadows
# the system one, and its %_dbpath (/var/lib/rpm) doesn't match Fedora's
# relocated db (/usr/lib/sysimage/rpm), so reprotest's `rpm -qa` bombs out. Put
# the system rpm tools ahead of Nix's, just for this run.
set -e
set -u
set -o pipefail

if [[ ! -x /usr/bin/rpmbuild ]]; then
    echo "ERROR: /usr/bin/rpmbuild not found; run 'just install-deps' on a Fedora host." >&2
    exit 1
fi

shim="$(mktemp -d)"
trap 'rm -rf "$shim"' EXIT
for tool in rpm rpmbuild rpm2cpio; do
    ln -s "/usr/bin/$tool" "$shim/$tool"
done
export PATH="$shim:$PATH"

# Run reprotest with all variations
reprotest -c "just rpm" . "rpm-build/RPMS/noarch/*.rpm"
