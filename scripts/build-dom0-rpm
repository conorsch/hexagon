#!/bin/bash
# Builds RPM for installation in dom0.
# RPM is fully reproducible.
set -e
set -u
set -o pipefail


if [[ -n "${VIRTUAL_ENV:-}" ]]; then
    echo "ERROR: unset VIRTUAL_ENV. Using a virtualenv interferes with package reproducibility."
    exit 1
fi

# Prepare tarball, rpmbuild will use it
mkdir -p dist/
rm -f dist/*.tar.gz
rm -f rpm-build/RPMS/noarch/*.rpm
/usr/bin/python3 setup.py sdist

# The spec relocates pip's output from the build host's python sitelib to the
# target dom0 version. On a Fedora host python3-rpm-macros defines
# %{python3_version}; outside it (e.g. the Nix dev shell) it isn't, so derive it
# from the interpreter that actually performs the install.
host_python_version="$(/usr/bin/python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"

# Use the epoch time of the highest semver tag available.
# SOURCE_DATE_EPOCH="$(git tag | sort -V | tail -n 1 | xargs git log -1 --format=%at)"
# Use the epoch time of the most recent commit. If works in dev,
# as well as building from signed tags.
SOURCE_DATE_EPOCH="$(git log -1 --format=%at HEAD)"
export SOURCE_DATE_EPOCH

# Place tarball where rpmbuild will find it
cp dist/*.tar.gz rpm-build/SOURCES/

# The version of Fedora used for building must match that of dom0;
# here's how this versions have lined up historically:
#
#   Qubes 4.0.x => F25 => python3.5
#   Qubes 4.1.x => F32 => python3.8
#   Qubes 4.2.x => F37 => python3.11
#   Qubes 4.3.x => F42 => python3.13
#
# Update the vars below to match
for i in 37 42; do
# for i in 37 ; do
    python_version="3.11"
    if [[ $i = 42 ]]; then
        python_version="3.13"
    fi
    dist=".fc${i}"
    echo "Building for dom0 based on ${dist} with Python version ${python_version}..."
    # --nodeps: BuildRequires are checked against an rpmdb in /var/lib/rpm, which
    # is absent outside a Fedora host; the dev shell supplies the tooling instead.
    rpmbuild \
        --quiet \
        --nodeps \
        --define "_topdir $PWD/rpm-build" \
        --define "_prefix /usr" \
        --define "dist $dist" \
        --define "_target_python_version $python_version" \
        --define "python3_version $host_python_version" \
        -bb --clean "rpm-build/SPECS/hexagon.spec"
done

printf '\nBuild complete! RPMs and their checksums are:\n\n'
find rpm-build/ -type f -iname '*.rpm' -print0 | sort -zV | xargs -0 sha256sum
