#!/bin/bash
# Reads and rewrites the single version declaration in pyproject.toml.
# Two forms occur: X.Y.Z (a release) and X.Y.ZaN (the alpha carried between
# releases). Computes by default; --write applies the result.
#
#   scripts/version                  # print the current version
#   scripts/version --stable         # what finalizing would give: 0.3.2a2 -> 0.3.2
#   scripts/version --alpha --write  # step the alpha: 0.3.2 -> 0.3.3a1, 0.3.2a1 -> 0.3.2a2
#   scripts/version 0.4.0 --write    # set explicitly
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

die() { echo "ERROR: $*" >&2; exit 1; }

write=false
mode=""
for arg in "$@"; do
    case "$arg" in
        --write|-w) write=true ;;
        --stable|--alpha) mode="$arg" ;;
        -*) die "unknown option: $arg" ;;
        *) mode="set"; explicit="$arg" ;;
    esac
done

current="$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml)"
[[ -n $current ]] || die "no 'version = ...' found in pyproject.toml."

case "$mode" in
    "")
        printf '%s\n' "$current"
        exit 0
        ;;
    --stable)
        next="$(sed -E 's/(a|b|rc)[0-9]+$//' <<< "$current")"
        [[ $next != "$current" ]] || die "${current} is already stable."
        ;;
    --alpha)
        # Walk an existing alpha forward, else open one on the next patch.
        if [[ $current =~ ^(.+)a([0-9]+)$ ]]; then
            next="${BASH_REMATCH[1]}a$(( BASH_REMATCH[2] + 1 ))"
        else
            next="${current%.*}.$(( ${current##*.} + 1 ))a1"
        fi
        ;;
    set)
        next="$explicit"
        [[ $next =~ ^[0-9]+(\.[0-9]+)*((a|b|rc)[0-9]+)?$ ]] || die "'${next}' is not a PEP 440 version."
        ;;
esac

if [[ $write == true ]]; then
    sed -i "s/^version = .*/version = \"${next}\"/" pyproject.toml
fi
printf '%s\n' "$next"
